const Room nextMove(Room currentRoom) {
    char input;
    cout << "Where would you like to move? (u, d, l, r)" << endl;
    cin >> input;
    switch(input) {
        case 'u':
            currentRoom.y -=1;
            return currentRoom;
            break;
        case 'd':
            currentRoom.y +=1;
            return currentRoom;
            break;
        case 'l':
            currentRoom.x -=1;
            return currentRoom;
            break;
        case 'r':
            currentRoom.x +=1;
            return currentRoom;
            break;
        default:
            cout << "Invalid Input" << endl;
            break;
    }

}