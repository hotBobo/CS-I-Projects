bool goodDirection(const Room &rm, const char dr) {
    switch (dr) {
        case 'u':
            if(rm.y-1<startRoom.y){
                return false;
            } else {return true;}
            break;

        case 'd':
            if(rm.y+1>cheeseRoom.y){
                return false;
            } else {return true;}
            break;

        case 'l':
            if(rm.x-1<startRoom.x){
                return false;
            } else {return true;}
            break;

        case 'r':
            if(rm.x+1>cheeseRoom.x){
                return false;
            } else {return true;}
            break;
            
        default:
            cout << "Invalid Direction (gDir)";
            exit(1);
            break;
    }
}

Room createAdjacent(const Room &rm, const char dr) {
    Room adj = rm;
    switch (dr) {
        case 'u':
            adj.y -= 1;
            return adj;
            break;

        case 'd':
            adj.y += 1;
            return adj;
            break;

        case 'l':
            adj.x -= 1;
            return adj;
            break;

        case 'r':
            adj.x += 1;
            return adj;
            break;
        
        default:
            cout << "Invalid Input (cAdj)" << endl;
            exit(1);
            break;
    }
}

const Room pickAdjacent(const Room &rm) {
    char pick[4] = {'u','d','l','r'};
    while(true) {
        int i = rand() % 4;
        if(goodDirection(rm,pick[i])){
            Room adj = createAdjacent(rm, pick[i]);
            return adj;
        } else {continue;}
    }
}

