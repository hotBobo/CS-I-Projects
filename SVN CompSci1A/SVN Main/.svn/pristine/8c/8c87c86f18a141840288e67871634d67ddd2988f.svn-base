#include <iostream>
#include <string>

using std::cin; using std::cout; using std::endl; using std::string;

int johnLowercase(int,int);


int main() {

    string John = "Hello";
    cout << John.insert(2, "AO");
    cout << John.replace(4, 2, " is hot.");
    cout << johnLowercase(4,5);

}

int johnLowercase(int i, int j) {
    return i*j;
}