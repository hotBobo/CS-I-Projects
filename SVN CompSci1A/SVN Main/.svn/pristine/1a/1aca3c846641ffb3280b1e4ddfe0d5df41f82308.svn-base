#include <iostream>

using std::cin; using std::cout; using std::endl;

int main(){
    double num, sum;
    cout << "Input sequence of integers (zero to stop): ";
    do {
        cin >> num;
        if (num > 0) {
        sum += num;
        }
    } while (num != 0);
    cout << "The sum of postive numbers is: " << sum;
}