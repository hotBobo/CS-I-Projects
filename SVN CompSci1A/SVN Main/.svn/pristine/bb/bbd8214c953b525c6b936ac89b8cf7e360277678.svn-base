#include <iostream>

using std::cin; using std::cout; using std::endl;
void swap(int&, int&);

void sort(int x, int y, int z){

  int tmp;

  if (x > y){
    swap(x,y);
  }

  if (y > z){
    swap(y,z);
  }

    if (x > y){
    swap(x,y);
  }

  cout << "The sorted numbers are: ";
  cout << x << " " << y << " " << z << endl;
}
void swap(int& left, int& right) {
    const int tmp = left;
    left = right;
    right = tmp;
}